# Copy to .env and fill in. NEVER commit .env.

# ── Required ────────────────────────────────────────────
SOWARD_TOKEN=your-bot-token-here

# ── Database (Mongo is optional; SQLite always runs locally) ──
SOWARD_MONGO_URI=mongodb://localhost:27017
SOWARD_MONGO_DB=soward

# ── Music (only needed if you want the Music cog) ───────
SOWARD_LAVALINK_HOST=127.0.0.1
SOWARD_LAVALINK_PORT=2333
SOWARD_LAVALINK_PASSWORD=youshallnotpass
SOWARD_LAVALINK_SECURE=false
# Optional: JSON list of nodes, overrides the four vars above
# SOWARD_LAVALINK_NODES=[{"host":"127.0.0.1","port":2333,"password":"...","secure":false,"identifier":"MAIN"}]
# Optional: Spotify search (both required to enable)
SOWARD_SPOTIFY_CLIENT_ID=
SOWARD_SPOTIFY_CLIENT_SECRET=

# ── Alerts cog (leave blank to disable a platform) ──────
SOWARD_YOUTUBE_API_KEY=
SOWARD_TWITCH_CLIENT_ID=
SOWARD_TWITCH_CLIENT_SECRET=

# ── Dev-only logging webhooks (leave blank to skip) ─────
SOWARD_DEV_LOG_COMMANDS_WEBHOOK=
SOWARD_DEV_LOG_LIFECYCLE_WEBHOOK=
SOWARD_DEV_LOG_ERRORS_WEBHOOK=
SOWARD_DEV_LOG_GUILDS_WEBHOOK=
# Identifies the channel for the auto-updating DB stats message
SOWARD_DEV_STATS_WEBHOOK=
