# Copy to .env and fill in. NEVER commit .env.

# ── Required ────────────────────────────────────────────
ZYRO_TOKEN=your-bot-token-here

# ── Database (Mongo is optional; SQLite always runs locally) ──
ZYRO_MONGO_URI=mongodb://localhost:27017
ZYRO_MONGO_DB=soward

# ── Music (only needed if you want the Music cog) ───────
ZYRO_LAVALINK_HOST=127.0.0.1
ZYRO_LAVALINK_PORT=2333
ZYRO_LAVALINK_PASSWORD=youshallnotpass
ZYRO_LAVALINK_SECURE=false
# Optional: JSON list of nodes, overrides the four vars above
# ZYRO_LAVALINK_NODES=[{"host":"127.0.0.1","port":2333,"password":"...","secure":false,"identifier":"MAIN"}]
# Optional: Spotify search (both required to enable)
ZYRO_SPOTIFY_CLIENT_ID=
ZYRO_SPOTIFY_CLIENT_SECRET=

# ── Alerts cog (leave blank to disable a platform) ──────
ZYRO_YOUTUBE_API_KEY=
ZYRO_WEBSUB=1
ZYRO_WEBSUB_CALLBACK=
ZYRO_WEBSUB_SECRET=
ZYRO_TWITCH_CLIENT_ID=
ZYRO_TWITCH_CLIENT_SECRET=

# ── Dev-only logging webhooks (leave blank to skip) ─────
ZYRO_DEV_LOG_COMMANDS_WEBHOOK=
ZYRO_DEV_LOG_LIFECYCLE_WEBHOOK=
ZYRO_DEV_LOG_ERRORS_WEBHOOK=
ZYRO_DEV_LOG_GUILDS_WEBHOOK=
# Identifies the channel for the auto-updating DB stats message
ZYRO_DEV_STATS_WEBHOOK=
ZYRO_BLOCKCYPHER_TOKEN=

# ── Web dashboard (Python/Flask, runs beside the bot) ───
# Discord application ID and secret from the Developer Portal (OAuth2 page)
ZYRO_CLIENT_ID=
ZYRO_CLIENT_SECRET=
# Set to 0 to turn the music Activity (served at /activity/) off
ZYRO_ACTIVITY=1
# Optional, for music Activity playback on hosts YouTube blocks: cookies file path and JS runtime name (node or deno)
ZYRO_YTDLP_COOKIES=
ZYRO_YTDLP_COOKIES_B64=
ZYRO_YTDLP_JS_RUNTIME=
# Public URL of the site, no trailing slash. Add <URL>/callback as an OAuth2 redirect.
ZYRO_DASHBOARD_URL=http://localhost:8080
# Long random string for signing session cookies
ZYRO_SESSION_SECRET=
# Web verification: secret mixed into stored address hashes. Changing it forgets earlier alt matches.
ZYRO_IP_SALT=
# Web verification: VPN detection provider, proxycheck or ipqs. none turns VPN detection off.
ZYRO_IPINTEL_PROVIDER=none
ZYRO_IPINTEL_KEY=
# Set to 1 when the site sits behind a proxy such as Render, so the real visitor address is read
ZYRO_BEHIND_PROXY=
# Optional Cloudflare Turnstile keys for the web verification page
ZYRO_TURNSTILE_SITE_KEY=
ZYRO_TURNSTILE_SECRET=
# Invite link to your support server (optional)
ZYRO_SUPPORT_URL=
ZYRO_CHANGELOG_CHANNEL=
ZYRO_VOTE_DBL_SECRET=
ZYRO_VOTE_NP_HOURS=12
ZYRO_DBL_TOKEN=

ZYRO_DEEPL_KEY=
ZYRO_TRANSLATE_EMAIL=
